# Docs (research, not tracked in hackathon repo)
docs/

# External references
references/

# Hackathon data (~20GB, DO NOT UPLOAD per hackathon rules) — anchored
# to repo root with leading slash so src/data/ (the bundled xT grid)
# stays tracked. Otherwise plain "data/" matches any data dir anywhere.
/data/

# Cache (only root-level cache/, never src/cache or test/cache)
/cache/

# Pipeline outputs (regenerated on AWS / local runs)
/outputs/

# Generated artefacts inside test/ (CSVs, MP4s, PNGs, MD reports, logs).
# All produced by the metric chain or the render scripts; the canonical
# location for these is outputs/. Only .py files belong in test/.
test/*.csv
test/*.mp4
test/*.png
test/*.md
test/*.log

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
dist/
build/
*.so

# Jupyter
.ipynb_checkpoints/
catboost_info/

# Environment
.env
*.env

# IDE / agent state (private to local dev — never tracked)
.vscode/
.idea/
.claude/
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Models
*.pkl
*.joblib
models/

# Figures (tracked selectively)
figures/*.mp4
