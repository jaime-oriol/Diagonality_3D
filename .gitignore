# Docs (research, not tracked in hackathon repo)
docs/

# Hackathon data (~20GB, DO NOT UPLOAD per hackathon rules) — anchored
# to repo root with leading slash so src/data/ (the bundled xT grid)
# stays tracked. Otherwise plain "data/" matches any data dir anywhere.
/data/

# Cache — root-level cache/ dir AND the cache -> aws_results/cache symlink
/cache

# Pipeline outputs (regenerated on AWS / local runs)
/outputs/

# Local mirror of AWS run results — track everything EXCEPT the cache
# (cache files are 850-950 MB each, exceed GitHub's 100MB hard limit;
# they are reproducible from data/hackathon via pipeline/regenerate_caches.py).
# Track tables, frames, videos, reports, intermediate CSVs and SUMMARY.md.
/aws_results/cache/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
dist/
build/
*.so

# Jupyter
.ipynb_checkpoints/
catboost_info/

# Environment
.env
*.env

# IDE / agent state (private to local dev — never tracked)
.vscode/
.idea/
.claude/
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Models
*.pkl
*.joblib
models/

# Figures (tracked selectively)
figures/*.mp4

# LaTeX build artifacts (the deliverable PDF is built on Overleaf/Tectonic)
deliverable/main.pdf
deliverable/*.synctex.gz
*.aux
*.bbl
*.blg
*.log
*.out
