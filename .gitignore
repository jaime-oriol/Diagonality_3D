# Docs (research, not tracked in hackathon repo)
docs/

# Hackathon data (~20GB, DO NOT UPLOAD per hackathon rules) — anchored
# to repo root with leading slash so src/data/ (the bundled xT grid)
# stays tracked. Otherwise plain "data/" matches any data dir anywhere.
/data/

# Cache — root-level cache/ symlink (points to results/cache)
/cache

# Pipeline outputs (regenerated on AWS / local runs)
/outputs/

# Run results — track everything EXCEPT the cache. Cache files are
# 850-950 MB each (exceed GitHub's 100MB hard limit) and are reproducible
# from data/hackathon via pipeline/regenerate_caches.py. Tracked inside
# results/: datasets/, tables/, reports/ and renders/.
/results/cache/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
dist/
build/
*.so

# Jupyter
.ipynb_checkpoints/
catboost_info/

# Environment
.env
*.env

# IDE / agent state (private to local dev — never tracked)
.vscode/
.idea/
.claude/
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Models
*.pkl
*.joblib
models/

# Figures (tracked selectively)
figures/*.mp4

# LaTeX build artifacts (the deliverable PDF is built on Overleaf/Tectonic)
deliverable/main.pdf
deliverable/*.synctex.gz
*.aux
*.bbl
*.blg
*.log
*.out
